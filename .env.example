# Gemini API configuration (never commit actual keys)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Local repository paths (read-only)
COURSE_REPO_PATH=/Users/wihl/Projects/Courses/26Fall/mathe139
EUCLID_TTS_PATH=/Users/wihl/Projects/codex/euclid-tts

# TTS configuration
# Options: google_erasmian, kokoro_erasmian, google_modern, macos_modern
TTS_BACKEND=google_erasmian
# Google Erasmian voices: en-US-Neural2-D (male), en-US-Neural2-J (male), en-US-Neural2-H (female, euclid-tts baseline)
TTS_VOICE_ERASMIAN=en-US-Neural2-D
# Google Modern Greek voices: el-GR-Wavenet-B, el-GR-Standard-A
TTS_VOICE_MODERN=el-GR-Wavenet-B
# Kokoro ONNX voice: am_adam, am_michael, af_heart, af_bella
TTS_VOICE_KOKORO=am_adam
# Speaking rate (0.72 - 0.82 recommended per euclid-tts prosody experiments)
TTS_RATE=0.78
TTS_LEVEL_SPEECH=true

# STT configuration
# Options: mlx-community/whisper-large-v3-turbo (110ms, best accuracy), mlx-community/whisper-small.en (60ms)
STT_MODEL=mlx-community/whisper-large-v3-turbo

# Audio routing device names (substring match against CoreAudio devices)
# BlackHole 2ch carries Zoom class audio into the capture pipeline
AUDIO_INPUT_DEVICE=BlackHole 2ch
# Physical mic fallback or operator mic for David scene / local testing
OPERATOR_MIC_DEVICE=MacBook Pro Microphone
# BlackHole 16ch carries Euclid audio (and gated operator mic) into Zoom's microphone input
AUDIO_OUTPUT_DEVICE=BlackHole 16ch
# Optional secondary monitor output (or use macOS Multi-Output Device)
AUDIO_MONITOR_DEVICE=

# OBS WebSocket configuration (optional pipeline-controlled scene switching)
OBS_WS_ENABLED=false
OBS_WS_HOST=127.0.0.1
OBS_WS_PORT=4455
OBS_WS_PASSWORD=
OBS_SCENE_DAVID=David
OBS_SCENE_EUCLID=Euclid

# Local web server
HOST=127.0.0.1
PORT=8765
