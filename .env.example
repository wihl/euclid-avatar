# Gemini API Key (never commit real keys; .env is gitignored)
# Automatically falls back to ~/Projects/Courses/26Fall/mathe139/.env or ~/Projects/codex/euclid-tts/.env if left blank
GEMINI_API_KEY=your_gemini_api_key_here

# Primary LLM model for Euclid's Q&A responses (gemini-3.5-flash-lite, gemini-3.1-flash-lite, gemini-3-flash-preview, or gemini-2.5-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# Strictly read-only path to the MATH E-139 course repository
COURSE_REPO_PATH=/Users/wihl/Projects/Courses/26Fall/mathe139

# Include ./local/recordings transcripts in read-only course index for II.13 Q&A context
INCLUDE_LOCAL_RECORDINGS=true

# Strictly read-only path to the existing euclid-tts repository
EUCLID_TTS_PATH=/Users/wihl/Projects/codex/euclid-tts

# Prepared 5-minute presentation file (Group 4: Book II, Proposition 13 Greek section)
PRESENTATION_FILE=presentation_ii13.yaml

# TTS Backend:
# - google_au_bilingual (default: Male Australian English + Erasmian Ancient Greek IPA in one voice)
# - google_erasmian (pure Erasmian Greek via SSML <phoneme>)
# - google_modern (el-GR Modern Greek)
# - kokoro_erasmian (local ONNX Kokoro-82M)
# - macos_modern (macOS say -v Melina)
TTS_BACKEND=google_au_bilingual

# Male Australian voice for English narration & bilingual Q&A:
# Options: en-AU-Neural2-D, en-AU-Chirp3-HD-Charon, en-AU-Chirp3-HD-Orus,
#          en-AU-Chirp3-HD-Fenrir, en-AU-News-G, en-AU-Polyglot-1, en-AU-Neural2-B
TTS_VOICE_ENGLISH=en-AU-Neural2-D

# Voice for Erasmian Ancient Greek (<phoneme alphabet="ipa">):
# Using the same en-AU male voice (e.g. en-AU-Neural2-D or en-AU-Chirp3-HD-Charon)
# allows seamless switching between Australian English and Erasmian Greek.
# Also supports en-US-Chirp3-HD-Charon, en-US-Studio-Q, en-US-Neural2-D.
TTS_VOICE_ERASMIAN=en-AU-Neural2-D
TTS_VOICE_MODERN=el-GR-Wavenet-B
TTS_VOICE_KOKORO=bm_george

# Speaking rates (English ~0.96, Erasmian Greek ~0.84)
TTS_RATE_ENGLISH=0.96
TTS_RATE=0.84
TTS_LEVEL_SPEECH=true

# Local STT model (Apple Silicon MLX Whisper)
STT_MODEL=mlx-community/whisper-large-v3-turbo

# Audio Devices (substring or exact name match; falls back to system default if not found)
AUDIO_INPUT_DEVICE=BlackHole 2ch
OPERATOR_MIC_DEVICE=MacBook Pro Microphone
AUDIO_OUTPUT_DEVICE=BlackHole 16ch
AUDIO_MONITOR_DEVICE=

# Optional OBS WebSocket 5.x scene switching
OBS_WS_ENABLED=false
OBS_WS_HOST=127.0.0.1
OBS_WS_PORT=4455
OBS_WS_PASSWORD=
OBS_SCENE_DAVID=David
OBS_SCENE_EUCLID=Euclid

# Local FastAPI server bind address (8787 avoids collision with digital-estate-server on 8765)
HOST=127.0.0.1
PORT=8787
